@page
@model OpportunitiesModel
@{
    ViewData["Title"] = "Opportunities";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-8">
        <h1 class="display-5 fw-bold">Find Opportunities</h1>
        <p class="lead text-muted">
            Search for cybersecurity roles that match your goals.
        </p>

        <form method="get" class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <label asp-for="JobTitleOrKeyword" class="form-label"></label>
                    <input asp-for="JobTitleOrKeyword" class="form-control" placeholder="For example, security analyst" />
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="For example, London or remote" />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="HasVisaSponsorshipPotential" class="form-check-input" />
                    <label asp-for="HasVisaSponsorshipPotential" class="form-check-label"></label>
                </div>

                <button type="submit" name="SearchSubmitted" value="true" class="btn btn-success">
                    Search Opportunities
                </button>
            </div>
        </form>

        @if (Model.SearchSubmitted)
        {
            <section class="mt-5" aria-labelledby="results-heading">
                <h2 id="results-heading" class="h3">Sample Opportunities</h2>
                <p class="text-muted">Sample data — live job sources not connected yet</p>

                @if (Model.Opportunities.Count == 0)
                {
                    <div class="alert alert-info" role="status">
                        No sample opportunities matched your search.
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var opportunity in Model.Opportunities)
                        {
                            var sponsorshipBadgeClass = opportunity.SponsorshipStatus switch
                            {
                                "Sponsorship Likely" => "text-bg-success",
                                "Sponsorship Unclear" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };

                            <div class="col-12">
                                <article class="card shadow-sm h-100">
                                    <div class="card-body">
                                        <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                                            <div>
                                                <h3 class="card-title h4 mb-1">@opportunity.JobTitle</h3>
                                                <p class="card-subtitle text-muted">@opportunity.Company</p>
                                            </div>
                                            <div>
                                                <span class="badge @sponsorshipBadgeClass">
                                                    @opportunity.SponsorshipStatus
                                                </span>
                                            </div>
                                        </div>

                                        <dl class="row mt-4 mb-0">
                                            <dt class="col-sm-3">Location</dt>
                                            <dd class="col-sm-9">@opportunity.Location</dd>

                                            <dt class="col-sm-3">Salary</dt>
                                            <dd class="col-sm-9">@opportunity.Salary</dd>

                                            <dt class="col-sm-3">Job type</dt>
                                            <dd class="col-sm-9">@opportunity.JobType</dd>

                                            <dt class="col-sm-3">Sponsorship evidence</dt>
                                            <dd class="col-sm-9">@opportunity.SponsorshipEvidence</dd>
                                        </dl>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>
